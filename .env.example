# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# LLM Model
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.7

# Embedding Model
EMBEDDING_MODEL=nomic-embed-text:v1.5
VECTOR_DIMENSION=768

# Vector Store Backend
VECTOR_STORE_BACKEND=chroma

# ChromaDB
CHROMA_PERSIST_DIR=./vector_db/chroma_db
CHROMA_COLLECTION_NAME=documents

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=secure_docs_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SCHEMA=public
POSTGRES_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/secure_docs_ai
POSTGRES_VECTOR_TABLE=document_chunks

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Logging
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Performance Optimisation Settings
# ---------------------------------------------------------------------------

# Ollama model keep-alive (seconds).
# 300 = 5 min (recommended for production).
# Use -1 to keep model loaded indefinitely (dev/local only — risk of VRAM OOM).
OLLAMA_KEEP_ALIVE=300

# Maximum number of models Ollama loads into VRAM simultaneously.
# Keep at 1 to prevent VRAM overflow when LLM and embedding model compete.
OLLAMA_MAX_LOADED_MODELS=1

# Enable true token streaming from Ollama → Streamlit UI.
# Set to false to fall back to the original non-streaming flow.
STREAMING_ENABLED=true

# Run rolling-summary update and memory extraction in background threads
# so the user receives the answer immediately after LLM generation.
ASYNC_POST_PROCESSING_ENABLED=true

# PostgreSQL connection pool sizes (sync psycopg pool).
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10

# Fuse query-rewriting into the main generation prompt (1 LLM call instead of 2).
# DISABLED by default — small models (qwen2.5:7b) produce lower-quality answers
# when asked to rewrite + answer + return JSON simultaneously.
# Set to true only if your model handles structured output reliably (e.g. larger models).
PROMPT_FUSION_ENABLED=false

# Maximum simultaneous LLM calls to Ollama (prevents GPU thrash).
LLM_MAX_CONCURRENT_CALLS=2

# Maximum number of requests that can queue for the LLM semaphore.
# Requests beyond this limit are rejected immediately.
LLM_MAX_QUEUE_SIZE=10

# Query-level answer cache (in-memory, TTL-based).
QUERY_CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# Embedding vector cache (in-memory LRU).
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_MAX_SIZE=1000

# Extra candidates fetched beyond k in hybrid search to compensate for ranking noise.
SEARCH_RESULT_BUFFER=5

# ---------------------------------------------------------------------------
# Response Quality Settings
# ---------------------------------------------------------------------------

# Default top-k for focused/fact-style questions.
DEFAULT_TOP_K=8

# Top-k for broad synthesis, comparison, listing, and analysis questions.
BROAD_QUERY_TOP_K=15

# Maximum characters packed into the final LLM context.
MAX_CONTEXT_CHARS=18000

# Add keyword-only retrieval for broad questions to recover exact headings,
# names, years, and technical phrases that embedding search can miss.
KEYWORD_SUPPLEMENT_ENABLED=true
KEYWORD_SUPPLEMENT_TOP_K=8
