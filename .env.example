# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# LLM Model
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.7

# Embedding Model
EMBEDDING_MODEL=nomic-embed-text:v1.5

# ChromaDB
CHROMA_PERSIST_DIR=./vector_db/chroma_db
CHROMA_COLLECTION_NAME=documents

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Logging
LOG_LEVEL=INFO
